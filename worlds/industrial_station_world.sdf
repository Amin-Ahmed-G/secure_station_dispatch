<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="industrial_station_world">

    <!-- ═══════════════════════════════════════════════════════════════
         World Systems
    ═══════════════════════════════════════════════════════════════ -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Sun -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range><constant>0.9</constant>
        <linear>0.01</linear><quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Fill light to reduce harsh shadows on markers -->
    <light type="directional" name="fill_light">
      <cast_shadows>false</cast_shadows>
      <pose>3 3 8 0 0 0</pose>
      <diffuse>0.4 0.4 0.4 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant></attenuation>
      <direction>0.3 -0.2 -0.8</direction>
    </light>

    <!-- ═══════════════════════════════════════════════════════════════
         Ground Plane — light grey warehouse floor
    ═══════════════════════════════════════════════════════════════ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <material>
            <ambient>0.72 0.72 0.72 1</ambient>
            <diffuse>0.72 0.72 0.72 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════
         Floor grid lines (cosmetic — 6 x 6 m warehouse zone)
    ═══════════════════════════════════════════════════════════════ -->
    <model name="floor_border">
      <static>true</static>
      <pose>3 3 0.005 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>6.2 6.2 0.01</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════
         STATION 0 — INSPECTION  (Blue)
         expected_pose [1.0, 2.0, 0.0]  →  sign face at y=2.4
    ═══════════════════════════════════════════════════════════════ -->

    <!-- Vertical post -->
    <model name="s0_post">
      <static>true</static>
      <pose>1.0 2.35 0.6 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><cylinder><radius>0.03</radius><length>1.2</length></cylinder></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
        </visual>
        <collision name="col">
          <geometry><cylinder><radius>0.03</radius><length>1.2</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <!-- Blue backing plate (frame) -->
    <model name="s0_backing">
      <static>true</static>
      <pose>1.0 2.38 0.65 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>0.72 0.04 0.92</size></box></geometry>
          <material>
            <ambient>0.08 0.33 0.72 1</ambient>
            <diffuse>0.08 0.33 0.72 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
        <collision name="col">
          <geometry><box><size>0.72 0.04 0.92</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- White inset (inner frame — keeps ArUco contrast clean) -->
    <model name="s0_inset">
      <static>true</static>
      <pose>1.0 2.41 0.60 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>0.62 0.02 0.72</size></box></geometry>
          <material>
            <ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ArUco marker panel — same size/position as original -->
    <model name="station_0_inspection">
      <static>true</static>
      <pose>1.0 2.43 0.55 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.6 0.02 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.02 0.6</size></box></geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <pbr><metal>
              <albedo_map>/home/aarock17/ros2_ws/src/secure_station_dispatch/models/materials/textures/marker_0.png</albedo_map>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Label shelf above marker -->
    <model name="s0_label_shelf">
      <static>true</static>
      <pose>1.0 2.39 1.02 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>0.62 0.05 0.12</size></box></geometry>
          <material>
            <ambient>0.05 0.22 0.55 1</ambient>
            <diffuse>0.05 0.22 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Base foot plate -->
    <model name="s0_foot">
      <static>true</static>
      <pose>1.0 2.35 0.03 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>0.25 0.25 0.06</size></box></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
        <collision name="col">
          <geometry><box><size>0.25 0.25 0.06</size></box></geometry>
        </collision>
      </link>
    </model>

