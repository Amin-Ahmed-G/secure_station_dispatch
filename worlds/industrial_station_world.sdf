    <model name="station_3_charging">
      <static>true</static>
      <pose>0.5 5.93 0.55 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.6 0.02 0.6</size></box></geometry>
        </collision>
