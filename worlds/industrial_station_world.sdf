         STATION 3 — CHARGING  (Red)
         expected_pose [0.5, 5.5, 0.0]  →  sign face at y=5.9
    ═══════════════════════════════════════════════════════════════ -->

    <model name="s3_post">
      <static>true</static>
      <pose>0.5 5.85 0.6 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><cylinder><radius>0.03</radius><length>1.2</length></cylinder></geometry>
