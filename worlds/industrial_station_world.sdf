<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="industrial_station_world">

    <!-- ═══════════════════════════════════════════════════════════════
         World Systems
    ═══════════════════════════════════════════════════════════════ -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Sun Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <attenuation>
        <range>1000</range><constant>0.9</constant>
        <linear>0.01</linear><quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Fill light -->
    <light type="directional" name="fill_light">
      <cast_shadows>false</cast_shadows>
      <pose>3 3 8 0 0 0</pose>
      <diffuse>0.4 0.4 0.4 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant></attenuation>
      <direction>0.3 -0.2 -0.8</direction>
    </light>

    <!-- ═══════════════════════════════════════════════════════════════
         Ground Plane & Zone Boundary
    ═══════════════════════════════════════════════════════════════ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>50 50</size></plane></geometry>
          <material>
            <ambient>0.72 0.72 0.72 1</ambient>
            <diffuse>0.72 0.72 0.72 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Floor border (6x6m zone indicator) -->
    <model name="floor_border">
      <static>true</static>
      <pose>3 3 0.005 0 0 0</pose>
      <link name="link">
        <visual name="vis">
          <geometry><box><size>6.2 6.2 0.01</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════
         MINIMAL STATIONS — ArUco Marker Panels (No blocking posts)
         Station expected_pose + 0.4m Y offset for visual standing distance
    ═══════════════════════════════════════════════════════════════ -->

    <!-- Station 0: Inspection Station (Marker ID 0) at [1.0, 2.0, 0.0] -->
    <model name="station_0_inspection">
      <static>true</static>
      <pose>1.0 2.40 0.40 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.6 0.01 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.01 0.6</size></box></geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <pbr><metal>
              <albedo_map>/home/aarock17/ros2_ws/src/secure_station_dispatch/models/materials/textures/marker_0.png</albedo_map>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Station 1: Assembly Station (Marker ID 1) at [4.5, 1.0, 0.0] -->
    <model name="station_1_assembly">
      <static>true</static>
      <pose>4.5 1.40 0.40 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.6 0.01 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.01 0.6</size></box></geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <pbr><metal>
              <albedo_map>/home/aarock17/ros2_ws/src/secure_station_dispatch/models/materials/textures/marker_1.png</albedo_map>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Station 2: Storage Station (Marker ID 2) at [4.5, 5.0, 0.0] -->
    <model name="station_2_storage">
      <static>true</static>
      <pose>4.5 5.40 0.40 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.6 0.01 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.01 0.6</size></box></geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <pbr><metal>
              <albedo_map>/home/aarock17/ros2_ws/src/secure_station_dispatch/models/materials/textures/marker_2.png</albedo_map>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Station 3: Charging Station (Marker ID 3) at [0.5, 5.5, 0.0] -->
    <model name="station_3_charging">
      <static>true</static>
      <pose>0.5 5.90 0.40 0 0 0</pose>
      <link name="link">
        <collision name="col">
          <geometry><box><size>0.6 0.01 0.6</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.6 0.01 0.6</size></box></geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <pbr><metal>
              <albedo_map>/home/aarock17/ros2_ws/src/secure_station_dispatch/models/materials/textures/marker_3.png</albedo_map>
            </metal></pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- ═══════════════════════════════════════════════════════════════
         AMR Mobile Robot with Symmetric Casters & Diff Drive
    ═══════════════════════════════════════════════════════════════ -->
    <model name="amr_robot">
      <pose>0.0 0.0 0.1 0 0 0</pose>

      <link name="chassis">
        <pose>0 0 0.05 0 0 0</pose>
        <inertial>
          <mass>5.0</mass>
          <inertia>
            <ixx>0.05</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.05</iyy><iyz>0</iyz><izz>0.08</izz>
          </inertia>
        </inertial>
        <collision name="chassis_col">
          <geometry><box><size>0.4 0.3 0.15</size></box></geometry>
        </collision>
        <visual name="chassis_vis">
          <geometry><box><size>0.4 0.3 0.15</size></box></geometry>
          <material>
            <ambient>0.1 0.3 0.8 1</ambient>
            <diffuse>0.1 0.3 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>

        <!-- Front Camera Sensor -->
        <sensor name="front_camera" type="camera">
          <pose>0.2 0 0.1 0 0 0</pose>
          <topic>/camera/image_raw</topic>
          <update_rate>10</update_rate>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>640</width><height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip><near>0.1</near><far>10.0</far></clip>
          </camera>
          <always_on>true</always_on>
          <visualize>true</visualize>
        </sensor>
      </link>

      <!-- Left Drive Wheel -->
      <link name="left_wheel">
        <pose>0 0.18 0 -1.5707 0 0</pose>
        <inertial>
          <mass>0.5</mass>
          <inertia><ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz></inertia>
        </inertial>
        <collision name="col">
          <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
      </link>

      <!-- Right Drive Wheel -->
      <link name="right_wheel">
        <pose>0 -0.18 0 -1.5707 0 0</pose>
        <inertial>
          <mass>0.5</mass>
          <inertia><ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz></inertia>
        </inertial>
        <collision name="col">
          <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
      </link>

      <!-- Rear-Left Caster -->
      <link name="caster_left">
        <pose>-0.15 0.10 -0.04 0 0 0</pose>
        <inertial>
          <mass>0.2</mass>
          <inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia>
        </inertial>
        <collision name="col">
          <geometry><sphere><radius>0.04</radius></sphere></geometry>
          <surface>
            <friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><sphere><radius>0.04</radius></sphere></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
      </link>

      <!-- Rear-Right Caster -->
      <link name="caster_right">
        <pose>-0.15 -0.10 -0.04 0 0 0</pose>
        <inertial>
          <mass>0.2</mass>
          <inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia>
        </inertial>
        <collision name="col">
          <geometry><sphere><radius>0.04</radius></sphere></geometry>
          <surface>
            <friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><sphere><radius>0.04</radius></sphere></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
      </link>

      <!-- Joints -->
      <joint name="left_wheel_joint" type="revolute">
        <parent>chassis</parent><child>left_wheel</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>

      <joint name="right_wheel_joint" type="revolute">
        <parent>chassis</parent><child>right_wheel</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>

      <joint name="caster_left_joint" type="ball">
        <parent>chassis</parent><child>caster_left</child>
      </joint>

      <joint name="caster_right_joint" type="ball">
        <parent>chassis</parent><child>caster_right</child>
      </joint>

      <!-- Differential Drive Plugin -->
      <plugin filename="gz-sim-diff-drive-system"
              name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.36</wheel_separation>
        <wheel_radius>0.08</wheel_radius>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <tf_topic>/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>chassis</child_frame_id>
      </plugin>

      <!-- Pose Publisher Plugin -->
      <plugin filename="gz-sim-pose-publisher-system"
              name="gz::sim::systems::PosePublisher">
        <publish_link_pose>true</publish_link_pose>
        <publish_nested_model_pose>true</publish_nested_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <update_frequency>20</update_frequency>
      </plugin>

    </model>

  </world>
</sdf>
