    <!-- ═══════════════════════════════════════════════════════════════
         AMR Robot  (Blue chassis, 2 drive wheels, 2 casters)
    ═══════════════════════════════════════════════════════════════ -->
    <model name="amr_robot">
      <pose>0.0 0.0 0.1 0 0 0</pose>

      <!-- Chassis -->
      <link name="chassis">
        <pose>0 0 0.05 0 0 0</pose>
        <inertial>
          <mass>5.0</mass>
          <inertia>
            <ixx>0.05</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.05</iyy><iyz>0</iyz><izz>0.08</izz>
          </inertia>
        </inertial>
        <collision name="chassis_col">
          <geometry><box><size>0.4 0.3 0.15</size></box></geometry>
        </collision>
        <visual name="chassis_vis">
          <geometry><box><size>0.4 0.3 0.15</size></box></geometry>
          <material>
            <ambient>0.1 0.3 0.8 1</ambient>
            <diffuse>0.1 0.3 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>

        <!-- Camera bump (visual) -->
        <visual name="cam_bump">
          <pose>0.21 0 0.06 0 0 0</pose>
          <geometry><box><size>0.04 0.06 0.04</size></box></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>

        <!-- Front Camera Sensor -->
        <sensor name="front_camera" type="camera">
          <pose>0.2 0 0.1 0 0 0</pose>
          <topic>/camera/image_raw</topic>
          <update_rate>10</update_rate>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>640</width><height>480</height>
              <format>R8G8B8</format>
            </image>
            <clip><near>0.1</near><far>10.0</far></clip>
          </camera>
          <always_on>true</always_on>
          <visualize>true</visualize>
        </sensor>
      </link>

      <!-- Left Drive Wheel -->
      <link name="left_wheel">
        <pose>0 0.18 0 -1.5707 0 0</pose>
        <inertial>
          <mass>0.5</mass>
          <inertia><ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz></inertia>
        </inertial>
        <collision name="col">
          <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
      </link>

      <!-- Right Drive Wheel -->
      <link name="right_wheel">
        <pose>0 -0.18 0 -1.5707 0 0</pose>
        <inertial>
          <mass>0.5</mass>
          <inertia><ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz></inertia>
        </inertial>
        <collision name="col">
          <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
        </collision>
        <visual name="vis">
          <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
          <material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material>
        </visual>
      </link>

      <!-- Rear-Left Caster (was the single rear caster, now mirrored pair) -->
      <link name="caster_left">
        <pose>-0.15 0.10 -0.04 0 0 0</pose>
        <inertial>
          <mass>0.2</mass>
          <inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia>
        </inertial>
        <collision name="col">
          <geometry><sphere><radius>0.04</radius></sphere></geometry>
          <surface>
            <friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><sphere><radius>0.04</radius></sphere></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
      </link>

      <!-- Rear-Right Caster (new — mirrors rear-left) -->
      <link name="caster_right">
        <pose>-0.15 -0.10 -0.04 0 0 0</pose>
        <inertial>
          <mass>0.2</mass>
          <inertia><ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz><iyy>0.0001</iyy><iyz>0</iyz><izz>0.0001</izz></inertia>
        </inertial>
        <collision name="col">
          <geometry><sphere><radius>0.04</radius></sphere></geometry>
          <surface>
            <friction><ode><mu>0.01</mu><mu2>0.01</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="vis">
          <geometry><sphere><radius>0.04</radius></sphere></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.25 0.25 0.25 1</diffuse></material>
        </visual>
      </link>

      <!-- Joints -->
      <joint name="left_wheel_joint" type="revolute">
        <parent>chassis</parent><child>left_wheel</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>

      <joint name="right_wheel_joint" type="revolute">
        <parent>chassis</parent><child>right_wheel</child>
        <axis><xyz>0 0 1</xyz></axis>
      </joint>

      <joint name="caster_left_joint" type="ball">
        <parent>chassis</parent><child>caster_left</child>
      </joint>

      <joint name="caster_right_joint" type="ball">
        <parent>chassis</parent><child>caster_right</child>
      </joint>

      <!-- Differential Drive Plugin (unchanged) -->
      <plugin filename="gz-sim-diff-drive-system"
              name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.36</wheel_separation>
        <wheel_radius>0.08</wheel_radius>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
        <tf_topic>/tf</tf_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>chassis</child_frame_id>
      </plugin>

      <!-- Pose Publisher Plugin -->
      <plugin filename="gz-sim-pose-publisher-system"
              name="gz::sim::systems::PosePublisher">
        <publish_link_pose>true</publish_link_pose>
        <publish_nested_model_pose>true</publish_nested_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <update_frequency>20</update_frequency>
      </plugin>

    </model>

  </world>
</sdf>
